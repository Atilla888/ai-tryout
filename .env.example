# PostgreSQL (used by docker compose for the postgres service)
POSTGRES_USER=aispacesuser
POSTGRES_PASSWORD=aispacespass
POSTGRES_DB=aispaces

# Satabase 
DATABASE_URL=postgresql+asyncpg://aispacesuser:aispacespass@localhost:5432/aispaces
ALEMBIC_DATABASE_URL=postgresql+psycopg://aispacesuser:aispacespass@localhost:5432/aispaces

# Backend
BACKEND_PORT=8000
SECRET_KEY=changeme-in-production
INTERNAL_SERVICE_TOKEN=changeme-internal-token

# Artifact files (maps to app.config artifact_storage_root)
ARTIFACT_STORAGE_ROOT=storage

# Orchestrator (apps/orchestrator)
API_BASE_URL=http://localhost:8000
CONCURRENCY_LIMIT=2
POLL_INTERVAL_SECONDS=3

# Frontend
VITE_API_URL=http://localhost:8000
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/ai-spaces
VITE_OIDC_CLIENT_ID=ai-spaces-frontend

# Authentication (backend)
# AUTH_PROVIDER=dev  -> no Keycloak required for local dev
# AUTH_PROVIDER=oidc -> validate Keycloak JWTs
AUTH_PROVIDER=dev
OIDC_ISSUER=http://localhost:8080/realms/ai-spaces
OIDC_AUDIENCE=ai-spaces-frontend
OIDC_VERIFY_AUDIENCE=true

# Keycloak admin (Docker)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
