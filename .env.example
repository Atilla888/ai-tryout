# =============================================================================
# AI-Spaces — root environment file (example)
#
# Copy this to `.env` in the repo root and adjust the values:
#     cp .env.example .env
#
# `.env` is gitignored — never commit it. These are the values Docker Compose
# interpolates (see docker-compose.yml) and that the backend reads directly
# when run outside a container (see apps/backend/app/core/config.py).
# The defaults below are safe for LOCAL DEVELOPMENT ONLY. Change every secret
# before any shared or public deployment.
# =============================================================================

# --- PostgreSQL -------------------------------------------------------------
# Used by the postgres container and interpolated into the DB URLs below.
POSTGRES_USER=aispacesuser
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=aispaces

# --- Database URLs ----------------------------------------------------------
# Compose sets these automatically from the values above, so you only need them
# here when running the backend directly on your host (not via Compose).
# The app uses the async driver; Alembic migrations use the sync driver.
#   Host (localhost) values:
DATABASE_URL=postgresql+asyncpg://aispacesuser:change-me-local-only@localhost:5432/aispaces
ALEMBIC_DATABASE_URL=postgresql+psycopg://aispacesuser:change-me-local-only@localhost:5432/aispaces

# --- Backend ----------------------------------------------------------------
# Port the backend is published on (host side).
BACKEND_PORT=8000

# Shared secret for internal backend <-> orchestrator calls. MUST match on both
# services. Generate a random value, e.g.:  openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=change-me-generate-a-random-token

# Where artifacts are written on the backend (leave as-is for local dev).
ARTIFACT_STORAGE_ROOT=storage

# --- Authentication ---------------------------------------------------------
# "dev"  = no Keycloak; every request is treated as a local admin user.
# "oidc" = validate real Keycloak JWTs (the OIDC_* values below take effect).
AUTH_PROVIDER=dev

# Only needed when AUTH_PROVIDER=oidc.
# IMPORTANT: OIDC_ISSUER must equal the URL the *browser* uses to log in (it is
# compared as a string against the token's `iss` claim), while OIDC_JWKS_URL
# must be reachable from *inside* the network where the backend runs. In Docker
# Compose / Kubernetes these are DIFFERENT hosts on purpose.
OIDC_ISSUER=http://localhost:8080/realms/ai-spaces
OIDC_JWKS_URL=http://localhost:8080/realms/ai-spaces/protocol/openid-connect/certs
OIDC_CLIENT_ID=ai-spaces-frontend
OIDC_ALGORITHM=RS256
OIDC_VERIFY_AUDIENCE=false

# --- Orchestrator / runner --------------------------------------------------
# "subprocess" = run the bundled fake runner locally (no cluster needed).
# "kubernetes" = launch one Kubernetes Job per run (needs cluster access).
RUNNER_BACKEND=subprocess