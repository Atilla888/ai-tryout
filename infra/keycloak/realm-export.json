{
  "realm": "ai-spaces",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "end_user", "description": "Can browse spaces and run jobs" },
      { "name": "space_creator", "description": "Can create and edit own spaces" },
      { "name": "admin", "description": "Full administrative access" }
    ]
  },
  "clients": [
    {
      "clientId": "ai-spaces-frontend",
      "name": "AI Spaces Frontend (SPA)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "audience-ai-spaces-frontend",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ai-spaces-frontend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin-user",
      "email": "admin@example.com",
      "firstName": "Ada",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "admin123", "temporary": false }
      ],
      "realmRoles": ["admin"]
    },
    {
      "username": "creator-user",
      "email": "creator@example.com",
      "firstName": "Cora",
      "lastName": "Creator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "creator123", "temporary": false }
      ],
      "realmRoles": ["space_creator"]
    },
    {
      "username": "end-user",
      "email": "user@example.com",
      "firstName": "Ulla",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "user123", "temporary": false }
      ],
      "realmRoles": ["end_user"]
    }
  ]
}
